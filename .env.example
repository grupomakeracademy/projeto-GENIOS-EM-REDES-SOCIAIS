# PUBLIC: only the publishable/anon key, protected by RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=http://127.0.0.1:3001
# Desenvolvimento local: contorna apenas o limite do e-mail padrão do Supabase.
LOCAL_SIGNUP_WITHOUT_EMAIL_CONFIRMATION=false
# 32 random bytes encoded as base64. Never store in the database.
CREDENTIAL_MASTER_KEY=
WORKER_SECRET=
# Optional server credentials (never NEXT_PUBLIC)
OPENAI_API_KEY=
# Server-only fallback: OPENAI_KEY
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Server-only fallbacks: GEMINI_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY
# Anthropic fallback: CLAUDE_API_KEY
TAVILY_API_KEY=

# Optional: direct PostgreSQL connection for migration/audit scripts (server only)
DATABASE_URL=
# E2E target; defaults to the local development server
TEST_BASE_URL=http://127.0.0.1:3001
# Opt in only when intentionally testing paid AI generation + scheduled routine
RUN_LIVE_ROUTINE_TEST=0
